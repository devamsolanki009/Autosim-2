# AutoSim-2 environment variables
# Copy this file to .env and fill in your values.

# WolframAlpha App ID — enables the WolframAlpha cross-check in the verifier.
# Get a free key at: https://developer.wolframalpha.com/
# 1. Sign up / log in at developer.wolframalpha.com
# 2. Click "Get an App ID"
# 3. Select the "Short Answers API" (free tier is enough)
# 4. Copy the App ID (looks like: XXXXXX-XXXXXXXXXX) and paste below
WOLFRAM_APP_ID= GEVGG2RHX4
